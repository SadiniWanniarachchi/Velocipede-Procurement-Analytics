      <aliases enabled='yes' />
      <column caption='Min Cost Per Product ' datatype='real' name='[Calculation_1415649292558337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Product Name] : MIN([Average Buying Price]) }' />
      </column>
      <column caption='Savings Opportunity' datatype='real' default-format='c&quot;$&quot;#,##0;(&quot;$&quot;#,##0)' name='[Calculation_1415649294512131]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    ( [Average Buying Price] - { FIXED [Product Name] : MIN([Average Buying Price]) } ) &#13;&#10;    * [PO Quantity]&#13;&#10;)' />
      </column>
